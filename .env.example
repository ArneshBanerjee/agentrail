# Copy to .env, or set these in your shell. All are optional.

# Port for the dashboard and API.
PORT=4318

# Password for the dashboard. Set it on any shared machine.
OPENSCOPE_ADMIN_TOKEN=

# Where the database lives.
OPENSCOPE_DATA_DIR=./data

# A model for drafting fixes. Not needed if Claude Code is installed and signed in.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
