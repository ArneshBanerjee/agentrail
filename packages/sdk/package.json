{
  "name": "@openscope/sdk",
  "version": "0.1.0",
  "description": "Collectors for OpenScope: HTTP middleware, a track API and an MCP server wrapper.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "source": "./src/mcp.ts",
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    }
  },
  "dependencies": {
    "@openscope/core": "^0.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "bin": {
    "openscope": "./dist/cli.js"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.20.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArneshBanerjee/openscope.git",
    "directory": "packages/sdk"
  }
}
